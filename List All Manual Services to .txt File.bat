PowerShell -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "((Get-Service | Where-Object {$_.StartType -eq 'Manual'} | Select-Object @{n='Type';e={'Service'}}, @{n='StartType';e={$_.StartType}}, Status, Name, DisplayName, @{n='PathName';e={''}}, ServiceType) + (Get-CimInstance Win32_SystemDriver | Where-Object {$_.StartMode -eq 'Manual'} | Select-Object @{n='Type';e={'Driver'}}, @{n='StartType';e={$_.StartMode}}, @{n='Status';e={$_.State}}, Name, DisplayName, PathName)) | Sort-Object Name | Format-Table Type, StartType, Status, Name, DisplayName, PathName -AutoSize | Out-String -Width 4096 | Out-File -FilePath \"$env:USERPROFILE\Desktop\Manual_Services_and_Drivers.txt\" -Encoding UTF8"