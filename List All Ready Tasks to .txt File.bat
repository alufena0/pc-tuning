PowerShell -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "Get-ScheduledTask | Where-Object {$_.State -eq 'Ready'} | Select-Object @{n='TaskName';e={$_.TaskName}}, @{n='Path';e={$_.TaskPath}}, State, @{n='LastResult';e={'0x{0:X}' -f $_.LastTaskResult}} | Sort-Object TaskName | Format-Table -AutoSize | Out-String -Width 4096 | Out-File -FilePath \"$env:USERPROFILE\Desktop\Ready_Scheduled_Tasks.txt\" -Encoding UTF8"