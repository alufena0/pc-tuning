[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\*\shell\CopyContents]
"Icon"="DxpTaskSync.dll,-52"
"MUIVerb"="Copy Contents to Clipboard"
[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\*\shell\CopyContents\command]
@="powershell.exe -NoProfile -NonInteractive -WindowStyle Hidden -Command \"$p='\"%1\"'; $b=[System.IO.File]::ReadAllBytes($p); $e=if($b.Length -ge 3 -and $b[0] -eq 0xEF -and $b[1] -eq 0xBB -and $b[2] -eq 0xBF){'UTF8'}elseif($b.Length -ge 2 -and $b[0] -eq 0xFF -and $b[1] -eq 0xFE){'Unicode'}elseif($b.Length -ge 2 -and $b[0] -eq 0xFE -and $b[1] -eq 0xFF){'BigEndianUnicode'}else{'UTF8'}; Get-Content -LiteralPath $p -Raw -Encoding $e | Set-Clipboard\""

