{
  "editor.mouseWheelZoom": true,
  "editor.formatOnSave": true,
  "editor.wordWrap": "on",
  "workbench.startupEditor": "none",
  "liveServer.settings.donotShowInfoMsg": true,
  "liveServer.settings.port": 5504,
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": [
          "comment",
          "comment.block",
          "comment.line",
          "comment.block.documentation",
        ],
        "settings": {
          "fontStyle": "italic",
          "foreground": "#6A9955AA",
        },
      },
    ],
  },
  "workbench.navigationControl.enabled": false,
  "editor.inlineSuggest.suppressSuggestions": true,
  "[javascript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features",
    "editor.maxTokenizationLineLength": 2000000,
  },
  "git.ignoreMissingGitWarning": true,
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.suggest.insertMode": "insert",
    "editor.suggestOnTriggerCharacters": true,
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "prettier.semi": true,
  "notebook.defaultFormatter": "esbenp.prettier-vscode",
  "workbench.settings.applyToAllProfiles": [],
  "editor.suggestOnTriggerCharacters": true,
  "javascript.suggest.enabled": true,
  "typescript.suggest.enabled": true,
  "editor.snippetSuggestions": "inline",
  "html.suggest.html5": true,
  "vscode_custom_css.imports": ["file://C:/Users/Administrator/custom.css"],
  "eslint.enable": true,
  "eslint.useFlatConfig": true,
  "eslint.options": {
    "overrideConfigFile": "C:\\Users\\Administrator\\eslint.config.js",
  },
  "eslint.rules.customizations": [
    {
      "rule": "no-undef",
      "severity": "off",
    },
  ],
  "prettier.singleQuote": true,
  "workbench.colorCustomizations": {
    "editorHint.foreground": "#ff0000",
  },
  "cSpell.ignoreRegExpList": [
    "(\\/\\/.*)|(\\/\\*[\\s\\S]*?\\*\\/)|(#.*)|(<!--([\\s\\S]*?)-->)|('''[\\s\\S]*?''')|(\"\"\"[\\s\\S]*?\"\"\")|(--.*)|(\\{-[\\s\\S]*?-\\})|(REM\\s.*)|(echo\\s.*)",
  ],
  "cSpell.useCustomDecorations": true,
  "cSpell.allowCompoundWords": true,
  "telemetry.telemetryLevel": "off",
  "explorer.confirmDragAndDrop": false,
  "editor.codeActionsOnSave": ["source.fixAll.eslint"],
  "emmet.includeLanguages": {
    "javascript": "javascriptreact",
    "vue-html": "html",
    "vue": "html",
  },
  "scm.compactFolders": false,
  "git.autofetch": true,
  "git.enableSmartCommit": true,
  "git.ignoreRebaseWarning": true,
  "git.confirmSync": false,
  "explorer.confirmDelete": true,
  "workbench.editor.empty.hint": "hidden",
  "github.copilot.enable": {
    "*": false,
  },
  "github.copilot.inlineSuggest.enable": false,
  "github.copilot.chat.enable": false,
  "github.copilot.editor.enableAutoCompletions": false,
  "github.copilot.editor.enableCodeActions": false,
  "github.copilot.nextEditSuggestions.enabled": false,
  "github.copilot.renameSuggestions.triggerAutomatically": false,
  "github.copilot.toggleCopilot": false,
  "github.copilot.completions.toggle": false,
  "chat.commandCenter.enabled": false,
  "chat.agent.enabled": false,
  "workbench.experimental.aiFeatures.enabled": false,
  "liveServer.settings.donotVerifyTags": true,
  "indentRainbow.colorOnWhiteSpaceOnly": true,
  "terminal.integrated.shellIntegration.enabled": false,
  "workbench.iconTheme": "vscode-icons",
  "editor.linkedEditing": true,
  "editor.scrollBeyondLastLine": false,
  "terminal.integrated.suggest.inlineSuggestion": "off",
  "editor.renderWhitespace": "all",
  "output.smartScroll.enabled": false,
  "editor.mouseWheelScrollSensitivity": 3,
  "editor.fastScrollSensitivity": 5,
  "editor.glyphMargin": true,
